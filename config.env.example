# backup-drive configuration. Copy to config.env (gitignored) and edit.
# One KEY="value" per line; only the keys below are accepted.

# The Google Drive for Desktop mount (source).
SOURCE_PATH="G:/My Drive"

# The backup folder on the external disk. It must contain an empty marker file named
# .backup-drive, created once by hand, or backup.sh refuses to run.
DEST_PATH="E:/Backup"

# Daily run time for schedule.sh install, 24-hour HH:MM.
SCHEDULE_TIME="HH:MM"
